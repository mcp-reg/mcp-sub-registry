{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Server Definition",
  "type": "object",
  "required": ["name", "description", "version"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "maxLength": 255
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "object"
    },
    "icons": {
      "type": "array"
    },
    "packages": {
      "type": "array"
    },
    "remotes": {
      "type": "array"
    }
  }
}
